# Supabase Public Configuration (Accessible in browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Site URL for OAuth Redirects (Accessible in browser)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase Server Configuration (Strictly server-side - DO NOT expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Gemini AI API Key (Strictly server-side - DO NOT expose to browser)
GEMINI_API_KEY=your-gemini-api-key

# Portal Verification Codes (Strictly server-side - DO NOT expose to browser)
STAFF_ACCESS_CODE=your-staff-access-code
ADMIN_ACCESS_CODE=your-admin-security-code
